# HTTP / Socket.IO port
PORT=3001
# development | production
NODE_ENV=development
# Comma-separated list of browser origins allowed to connect cross-origin.
# Not needed when the server also serves the built client (same origin).
CLIENT_ORIGIN=http://localhost:5173
# How long (ms) a disconnected player keeps their seat before it is vacated
RECONNECT_GRACE_MS=120000
# Rooms with nobody connected are deleted after this many ms
ROOM_IDLE_TTL_MS=600000
# Set to true only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false
# Optional: path to the built client (defaults to ../client/dist)
# CLIENT_DIST=/app/client/dist
